{
  "$schema": "../schemas/profile-v1.schema.json",
  "formatVersion": 1,
  "id": "daily",
  "description": "Direct terminal coding Agent: inspect first, approve project-local coding once per process, use bounded visible subagents, and keep public Web separately confirmed.",
  "packageIds": [
    "plan-mode",
    "agent-extensions",
    "permission-modes",
    "lsp",
    "usage",
    "subagents",
    "web-access"
  ],
  "capabilityIds": [
    "workspace-read",
    "planning",
    "session-management",
    "context-management",
    "review-assistance",
    "notifications",
    "subagent-runtime",
    "subagent-rpc-v1",
    "subagent-delegation-v1",
    "web-access",
    "permission-policy",
    "bash-sandbox-conditional",
    "file-tool-policy",
    "lsp",
    "usage-observability",
    "session-ledger-metadata",
    "context-observability",
    "guarded-project-coding"
  ],
  "policy": {
    "projectTrust": "ask",
    "approval": "ask",
    "network": "public-ssrf-guarded",
    "browserCookies": false,
    "tools": ["read", "grep", "find", "ls", "edit", "write", "bash", "web"],
    "session": "central-user-session-dir",
    "contextFiles": "review-before-trust",
    "subagents": {
      "enabled": true,
      "maxDepth": 1,
      "maxConcurrency": 2,
      "writerRequiresWorktree": false,
      "writerIsolation": "managed-clone",
      "defaultRole": "scout"
    },
    "mcp": {
      "enabled": false,
      "hostConfigDiscovery": "off"
    }
  }
}
