{
  "$schema": "https://only-my-pi.invalid/schemas/profile-v1.json",
  "formatVersion": 1,
  "id": "coding",
  "description": "Daily coding profile with conservative approvals and one memory owner.",
  "packageIds": [
    "plan-mode",
    "agent-extensions",
    "permission-modes",
    "lsp",
    "usage",
    "memory",
    "git-sync"
  ],
  "policy": {
    "projectTrust": "ask",
    "approval": "ask",
    "network": "deny-unless-explicit",
    "session": "central-user-session-dir",
    "contextFiles": "review-before-trust",
    "subagents": {
      "enabled": false,
      "maxDepth": 1,
      "maxConcurrency": 1,
      "writerRequiresWorktree": true
    },
    "mcp": {
      "enabled": false,
      "hostConfigDiscovery": "off"
    },
    "memory": {
      "owner": "memory",
      "allowSecondMemory": false
    }
  }
}
