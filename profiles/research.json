{
  "$schema": "../schemas/profile-v1.schema.json",
  "formatVersion": 1,
  "id": "research",
  "description": "Opt-in single-agent research profile with web access; orchestration is a separate profile.",
  "packageIds": [
    "plan-mode",
    "agent-extensions",
    "permission-modes",
    "lsp",
    "usage",
    "memory",
    "git-sync",
    "web-access"
  ],
  "capabilityIds": [
    "workspace-read",
    "planning",
    "session-management",
    "context-management",
    "review-assistance",
    "notifications",
    "web-access",
    "permission-policy",
    "bash-sandbox-conditional",
    "file-tool-policy",
    "lsp",
    "usage-observability",
    "memory",
    "configuration-sync",
    "session-ledger-metadata",
    "context-observability"
  ],
  "policy": {
    "projectTrust": "ask",
    "approval": "ask",
    "network": "allow-listed-only",
    "browserCookies": false,
    "session": "central-user-session-dir",
    "contextFiles": "review-before-trust",
    "subagents": {
      "enabled": false,
      "maxDepth": 1,
      "maxConcurrency": 1,
      "writerRequiresWorktree": true
    },
    "mcp": {
      "enabled": false,
      "hostConfigDiscovery": "off"
    },
    "memory": {
      "owner": "memory",
      "allowSecondMemory": false
    }
  }
}
