{
  "$schema": "../schemas/profile-v1.schema.json",
  "formatVersion": 1,
  "id": "research",
  "description": "Opt-in research profile with web access and bounded read-oriented subagents.",
  "packageIds": [
    "plan-mode",
    "agent-extensions",
    "permission-modes",
    "lsp",
    "usage",
    "memory",
    "git-sync",
    "web-access"
  ],
  "policy": {
    "projectTrust": "ask",
    "approval": "ask",
    "network": "allow-listed-only",
    "browserCookies": false,
    "session": "central-user-session-dir",
    "contextFiles": "review-before-trust",
    "subagents": {
      "enabled": true,
      "maxDepth": 1,
      "maxConcurrency": 2,
      "writerRequiresWorktree": true,
      "defaultRole": "scout-or-reviewer"
    },
    "mcp": {
      "enabled": false,
      "hostConfigDiscovery": "off"
    },
    "memory": {
      "owner": "memory",
      "allowSecondMemory": false
    }
  }
}
