{
  "formatVersion": 1,
  "id": "upstream-compatibility-gates-v1",
  "description": "Fixed no-shell M9 upstream compatibility gate contract. U1-U8 are deterministic and credential-free; U9 remains protected evidence-only and never runs in ordinary CI.",
  "baseline": { "piVersion": "0.84.1", "subagentsVersion": "0.45.2" },
  "candidate": { "piVersion": "0.84.3", "subagentsVersion": "0.57.0" },
  "policy": {
    "cwd": "repository-root",
    "network": "deny",
    "shell": false,
    "protectedExecution": "evidence-only",
    "maxGateCount": 9,
    "maxOutputBytes": 8388608
  },
  "gates": [
    {
      "id": "U1",
      "description": "Candidate provenance, contract, schema, and non-mutating CLI.",
      "command": "node",
      "args": ["--test", "tests/upstream-compatibility.test.mjs", "tests/m9-upstream-compatibility-cli.test.mjs"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 120000,
      "maxOutputBytes": 2097152,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U2",
      "description": "Exact RPC, delegation, live-probe, and capability dialect compatibility.",
      "command": "node",
      "args": ["--test", "tests/subagents-live-probe.test.mjs", "tests/subagents-backend-adapter.test.mjs", "tests/subagents-delegation-adapter.test.mjs"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 180000,
      "maxOutputBytes": 4194304,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U3",
      "description": "Candidate session runtime composition and all five read-only executor adapters.",
      "command": "node",
      "args": ["--test", "tests/session-runtime-composer.test.mjs"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 240000,
      "maxOutputBytes": 4194304,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U4",
      "description": "Background status, cancellation, resume, terminal correlation, and recovery.",
      "command": "node",
      "args": ["--test", "tests/subagents-backend-adapter.test.mjs", "tests/subagents-run-coordinator.test.mjs"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 300000,
      "maxOutputBytes": 4194304,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U5",
      "description": "Candidate full-stack evidence, Web SSRF policy, and project Gate safety.",
      "command": "node",
      "args": ["--test", "tests/upstream-compatibility.test.mjs", "tests/web-policy.test.mjs", "tests/project-gates.test.mjs"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 180000,
      "maxOutputBytes": 4194304,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U6",
      "description": "Version-paired runtime resource and lifecycle soak.",
      "command": "node",
      "args": ["--test", "tests/subagents-resource-leak.test.mjs"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 300000,
      "maxOutputBytes": 4194304,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U7",
      "description": "Pack allowlist, schemas, links, evidence, and CI consistency.",
      "command": "node",
      "args": ["--test", "tests/pack-content.test.mjs", "tests/docs-links.test.mjs", "tests/ci-contract.test.mjs", "tests/schema-validation.test.mjs"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 240000,
      "maxOutputBytes": 4194304,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U8",
      "description": "Complete repository regression with Stable and M8 behavior preserved.",
      "command": "npm",
      "args": ["test"],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 600000,
      "maxOutputBytes": 8388608,
      "sensitiveOutput": false,
      "required": true,
      "execution": "deterministic"
    },
    {
      "id": "U9",
      "description": "Protected candidate live read-only matrix using explicitly authorized credentials.",
      "command": null,
      "args": [],
      "cwd": "repository-root",
      "env": { "CI": "1", "NO_COLOR": "1", "PI_TELEMETRY": "0" },
      "timeoutMs": 1,
      "maxOutputBytes": 1024,
      "sensitiveOutput": false,
      "required": true,
      "execution": "protected-evidence",
      "defaultStatus": "NOT_RUN_BY_POLICY",
      "evidenceIds": ["m9-candidate-live-readonly-matrix"]
    }
  ]
}
