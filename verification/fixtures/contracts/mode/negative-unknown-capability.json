{
  "$schema": "../../../../schemas/mode-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "contract-only",
  "id": "fixture-inspect",
  "version": "1.0.0",
  "displayName": "Fixture Inspect",
  "description": "Unknown capability must fail semantic validation.",
  "category": "core",
  "executionState": "ask",
  "extends": [],
  "requires": { "profileCapabilities": ["capability-does-not-exist"], "packages": [], "enforcementSurfaces": ["fileToolPolicy"] },
  "prompt": { "file": "modes/prompts/inspect.md" },
  "tools": { "allow": ["read"], "deny": ["write", "bash"], "required": ["read"] },
  "policy": { "workspace": "read-only", "egress": { "web": "deny", "mcp": "deny", "provider": "inherit", "extension": "deny" }, "approval": "deny" },
  "workflow": { "default": "single-agent-safe", "fallback": "single-agent-safe" },
  "swarm": { "allowed": false, "defaultRecipe": null },
  "completion": { "gates": ["structured-inspection"], "requiresStructuredVerdict": true },
  "risk": "low"
}
