{
  "$schema": "../../../../schemas/workflow-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "contract-only",
  "id": "fixture-policy-reference",
  "version": "1.0.0",
  "description": "Every policyRef must reference a known mode policy.",
  "entryConditions": ["profile-resolved"],
  "mutationScope": "none",
  "budget": { "maxSteps": 2, "maxParallel": 1, "timeoutSeconds": 1200, "retry": 0, "maxOutputBytes": 65536 },
  "fallback": { "when": ["unavailable-runner"], "workflow": null, "requiresApproval": false },
  "steps": [
    { "id": "inspect", "action": "agent", "agent": "scout", "needs": [], "policyRef": "missing-mode", "approval": "none" },
    { "id": "verify", "action": "gate", "gate": "test-contract", "needs": ["inspect"], "policyRef": "inspect", "approval": "none" }
  ],
  "terminal": { "step": "verify", "acceptedVerdicts": ["pass"], "rejectedVerdicts": ["fail"], "requiresVerifierGate": true },
  "cancellation": { "stopAdmission": true, "waitForTerminalProof": true, "terminalVerdict": "cancelled" },
  "failure": { "onStepFailure": "fail", "onGateFailure": "fail" },
  "recovery": { "durableState": true, "verifySourceHash": true, "resumeFrom": "last-settled-step" }
}
