{
  "$schema": "../../../../schemas/workflow-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "contract-only",
  "id": "fixture-unknown-gate",
  "version": "1.0.0",
  "description": "A Workflow gate must resolve to the immutable release gate registry.",
  "entryConditions": ["profile-resolved", "mode-resolved", "session-idle"],
  "mutationScope": "none",
  "budget": { "maxSteps": 2, "timeoutSeconds": 1200, "maxOutputBytes": 65536 },
  "fallback": { "when": ["unavailable-runner"], "workflow": null, "requiresApproval": false },
  "steps": [
    { "id": "inspect", "action": "agent", "agent": "scout", "needs": [], "policyRef": "inspect", "approval": "none" },
    { "id": "verify", "action": "gate", "gate": "arbitrary-not-in-registry", "needs": ["inspect"], "policyRef": "inspect", "approval": "none" }
  ],
  "terminal": { "step": "verify", "acceptedVerdicts": ["pass"], "rejectedVerdicts": ["fail", "blocked", "cancelled"], "requiresVerifierGate": true },
  "cancellation": { "stopAdmission": true, "waitForTerminalProof": true, "terminalVerdict": "cancelled" },
  "failure": { "onStepFailure": "fail", "onGateFailure": "fail" },
  "recovery": { "durableState": true, "verifySourceHash": true, "resumeFrom": "last-settled-step" }
}
