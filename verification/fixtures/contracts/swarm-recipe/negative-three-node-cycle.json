{
  "$schema": "../../../../schemas/swarm-recipe-v1.schema.json", "formatVersion": 1, "contractStatus": "contract-only", "id": "fixture-three-cycle", "version": "1.0.0", "description": "A non-self three-node cycle must fail.", "readOnly": true,
  "budget": { "maxDepth": 1, "maxConcurrency": 3, "maxChildren": 3, "childTimeoutSeconds": 900, "runTimeoutSeconds": 2700, "retry": 0, "nestedSwarm": false, "childOutputBytes": 51200, "parentSummaryBytes": 8192 },
  "writerPolicy": { "sharedCwdMaxWriters": 1, "parallelWriters": "managed-worktree-only", "onConflict": "reject" },
  "nodes": [
    { "id": "cycle-a", "agent": "scout", "taskTemplate": "cycle-a", "needs": ["cycle-c"], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 900, "retry": 0 },
    { "id": "cycle-b", "agent": "scout", "taskTemplate": "cycle-b", "needs": ["cycle-a"], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 900, "retry": 0 },
    { "id": "cycle-c", "agent": "scout", "taskTemplate": "cycle-c", "needs": ["cycle-b"], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 900, "retry": 0 }
  ],
  "aggregation": { "strategy": "stable-array", "order": "topological-then-node-id", "includePartial": false, "maxOutputBytes": 65536 }, "verifier": "cycle-c",
  "cancellation": { "stopAdmission": true, "cancelRunning": true, "disableRetry": true, "waitForTerminalProof": true }
}
