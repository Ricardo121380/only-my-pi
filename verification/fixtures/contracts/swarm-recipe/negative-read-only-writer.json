{
  "$schema": "../../../../schemas/swarm-recipe-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "contract-only",
  "id": "fixture-research",
  "version": "1.0.0",
  "description": "Read-only writer escalation must fail semantic validation.",
  "readOnly": true,
  "budget": { "maxDepth": 1, "maxConcurrency": 1, "maxChildren": 1, "childTimeoutSeconds": 900, "runTimeoutSeconds": 1800, "retry": 0, "nestedSwarm": false, "childOutputBytes": 51200, "parentSummaryBytes": 8192 },
  "writerPolicy": { "sharedCwdMaxWriters": 1, "parallelWriters": "managed-worktree-only", "onConflict": "reject" },
  "nodes": [{ "id": "verify", "agent": "scout", "taskTemplate": "verify-source", "needs": [], "workspace": "shared-guarded", "writer": true, "timeoutSeconds": 900, "retry": 0 }],
  "aggregation": { "strategy": "stable-array", "order": "topological-then-node-id", "includePartial": false, "maxOutputBytes": 65536 },
  "verifier": "verify",
  "cancellation": { "stopAdmission": true, "cancelRunning": true, "disableRetry": true, "waitForTerminalProof": true }
}
