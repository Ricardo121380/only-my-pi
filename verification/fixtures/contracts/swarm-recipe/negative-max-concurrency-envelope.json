{
  "$schema": "../../../../schemas/swarm-recipe-v1.schema.json", "formatVersion": 1, "contractStatus": "contract-only", "id": "fixture-concurrency-budget", "version": "1.0.0", "description": "DAG width cannot exceed maxConcurrency.", "readOnly": true,
  "budget": { "maxDepth": 1, "maxConcurrency": 2, "maxChildren": 3, "childTimeoutSeconds": 900, "runTimeoutSeconds": 900, "retry": 0, "nestedSwarm": false, "childOutputBytes": 51200, "parentSummaryBytes": 8192 },
  "writerPolicy": { "sharedCwdMaxWriters": 1, "parallelWriters": "managed-worktree-only", "onConflict": "reject" },
  "nodes": [
    { "id": "research-a", "agent": "scout", "taskTemplate": "research-a", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 100, "retry": 0 },
    { "id": "research-b", "agent": "scout", "taskTemplate": "research-b", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 100, "retry": 0 },
    { "id": "verify", "agent": "scout", "taskTemplate": "verify-source", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 100, "retry": 0 }
  ],
  "aggregation": { "strategy": "stable-array", "order": "topological-then-node-id", "includePartial": false, "maxOutputBytes": 65536 }, "verifier": "verify",
  "cancellation": { "stopAdmission": true, "cancelRunning": true, "disableRetry": true, "waitForTerminalProof": true }
}
