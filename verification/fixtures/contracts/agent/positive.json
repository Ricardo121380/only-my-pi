{
  "$schema": "../../../../schemas/agent-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "contract-only",
  "id": "fixture-scout",
  "upstreamAgentId": "omp-fixture-scout",
  "version": "1.0.0",
  "description": "Valid read-only Agent fixture.",
  "prompt": { "file": "agents/prompts/scout.md" },
  "tools": { "allow": ["read", "grep", "find", "ls"], "deny": ["edit", "write", "bash", "web"] },
  "allowedExecutionStates": ["ask", "plan", "review"],
  "requiredCapabilities": ["workspace-read"],
  "policyCeiling": { "workspace": "read-only", "egress": { "web": "deny", "mcp": "deny", "provider": "inherit", "extension": "deny" }, "approval": "deny", "mutation": "none" },
  "modelRole": "inherit",
  "inputSchema": { "type": "object", "additionalProperties": false, "properties": { "task": { "type": "string" } }, "required": ["task"] },
  "outputSchema": { "type": "object", "additionalProperties": false, "properties": { "summary": { "type": "string" } }, "required": ["summary"] },
  "writer": false,
  "timeoutSeconds": 900,
  "continuable": false,
  "resumable": false,
  "redaction": { "rawPrompts": "omit", "reasoning": "omit", "credentials": "deny", "maxOutputBytes": 51200 },
  "gateIds": []
}
