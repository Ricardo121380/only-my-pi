{
  "$schema": "../../schemas/swarm-recipe-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "runtime-ready",
  "id": "debug-hypotheses",
  "version": "1.0.0",
  "description": "Read-only competing hypotheses and evidence verification; fixes require a separate approved coding workflow.",
  "readOnly": true,
  "budget": { "maxDepth": 1, "maxConcurrency": 2, "maxChildren": 3, "childTimeoutSeconds": 900, "runTimeoutSeconds": 2400, "retry": 0, "nestedSwarm": false, "childOutputBytes": 51200, "parentSummaryBytes": 8192 },
  "writerPolicy": { "sharedCwdMaxWriters": 1, "parallelWriters": "managed-worktree-only", "onConflict": "reject" },
  "nodes": [
    { "id": "hypothesis-a", "agent": "explorer", "taskTemplate": "debug-hypothesis-a", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 900, "retry": 0 },
    { "id": "hypothesis-b", "agent": "explorer", "taskTemplate": "debug-hypothesis-b", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 900, "retry": 0 },
    { "id": "verify", "agent": "verifier", "taskTemplate": "verify-root-cause", "needs": ["hypothesis-a", "hypothesis-b"], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 600, "retry": 0 }
  ],
  "aggregation": { "strategy": "verified-synthesis", "order": "topological-then-node-id", "includePartial": true, "maxOutputBytes": 65536 },
  "verifier": "verify",
  "cancellation": { "stopAdmission": true, "cancelRunning": true, "disableRetry": true, "waitForTerminalProof": true }
}
