{
  "$schema": "../../schemas/swarm-recipe-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "runtime-ready",
  "id": "review-matrix",
  "version": "1.0.0",
  "description": "Read-only parallel quality, security, and regression review followed by a verifier verdict.",
  "readOnly": true,
  "budget": { "maxDepth": 1, "maxConcurrency": 3, "maxChildren": 4, "childTimeoutSeconds": 1200, "runTimeoutSeconds": 2400, "retry": 0, "nestedSwarm": false, "childOutputBytes": 51200, "parentSummaryBytes": 8192 },
  "writerPolicy": { "sharedCwdMaxWriters": 1, "parallelWriters": "managed-worktree-only", "onConflict": "reject" },
  "nodes": [
    { "id": "quality", "agent": "reviewer", "taskTemplate": "quality-review", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 900, "retry": 0 },
    { "id": "security", "agent": "security-reviewer", "taskTemplate": "security-review", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 1200, "retry": 0 },
    { "id": "regression", "agent": "test-analyst", "taskTemplate": "regression-review", "needs": [], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 900, "retry": 0 },
    { "id": "verify", "agent": "verifier", "taskTemplate": "review-verdict", "needs": ["quality", "security", "regression"], "workspace": "shared-read-only", "writer": false, "timeoutSeconds": 600, "retry": 0 }
  ],
  "aggregation": { "strategy": "stable-array", "order": "topological-then-node-id", "includePartial": true, "maxOutputBytes": 65536 },
  "verifier": "verify",
  "cancellation": { "stopAdmission": true, "cancelRunning": true, "disableRetry": true, "waitForTerminalProof": true }
}
