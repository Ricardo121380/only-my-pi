{
  "$schema": "../schemas/agent-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "runtime-ready",
  "id": "tester",
  "upstreamAgentId": "omp-tester",
  "version": "1.0.0",
  "description": "Read-only test analyst that consumes deterministic allow-listed gate receipts.",
  "prompt": { "file": "agents/prompts/tester.md" },
  "tools": { "allow": ["read", "grep", "find", "ls"], "deny": ["bash", "edit", "write", "web"] },
  "allowedExecutionStates": ["build", "review"],
  "requiredCapabilities": ["workspace-read"],
  "policyCeiling": { "workspace": "read-only", "egress": { "web": "deny", "mcp": "deny", "provider": "inherit", "extension": "deny" }, "approval": "deny", "mutation": "none" },
  "modelRole": "fast",
  "inputSchema": { "type": "object", "additionalProperties": false, "properties": { "gateReceipts": { "type": "array", "description": "Deterministic gate receipts." } }, "required": ["gateReceipts"] },
  "outputSchema": { "type": "object", "additionalProperties": false, "properties": { "verdict": { "type": "string", "description": "pass or fail." }, "failures": { "type": "array", "description": "Bounded failures." } }, "required": ["verdict", "failures"] },
  "writer": false,
  "timeoutSeconds": 900,
  "continuable": false,
  "resumable": true,
  "redaction": { "rawPrompts": "omit", "reasoning": "omit", "credentials": "deny", "maxOutputBytes": 65536 },
  "gateIds": ["typecheck", "schema-check", "full-tests"]
}
