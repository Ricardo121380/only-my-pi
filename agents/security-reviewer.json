{
  "$schema": "../schemas/agent-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "runtime-ready",
  "id": "security-reviewer",
  "upstreamAgentId": "omp-security-reviewer",
  "version": "1.0.0",
  "description": "Read-only security reviewer for trust, path, secret, process, and network boundaries.",
  "prompt": { "file": "agents/prompts/security-reviewer.md" },
  "tools": { "allow": ["read", "grep", "find", "ls"], "deny": ["bash", "edit", "write", "web"] },
  "allowedExecutionStates": ["review"],
  "requiredCapabilities": ["workspace-read", "review-assistance"],
  "policyCeiling": { "workspace": "read-only", "egress": { "web": "deny", "mcp": "deny", "provider": "inherit", "extension": "deny" }, "approval": "deny", "mutation": "none" },
  "modelRole": "deep",
  "inputSchema": { "type": "object", "additionalProperties": false, "properties": { "scope": { "type": "string", "description": "Review scope." } }, "required": ["scope"] },
  "outputSchema": { "type": "object", "additionalProperties": false, "properties": { "findings": { "type": "array", "description": "Severity-ranked findings." }, "verdict": { "type": "string", "description": "pass or fail." } }, "required": ["findings", "verdict"] },
  "writer": false,
  "timeoutSeconds": 1200,
  "continuable": false,
  "resumable": true,
  "redaction": { "rawPrompts": "omit", "reasoning": "omit", "credentials": "deny", "maxOutputBytes": 65536 },
  "gateIds": ["diff-check"]
}
