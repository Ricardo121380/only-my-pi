    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/session-ledger/index.ts",
      "./extensions/context-doctor/index.ts",
      "./extensions/omp-control/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ],
    "subagents": {
      "agents": [
        "./bundles/only-my-pi-agent-bundle/agents"
      ]
    }
  }
}
