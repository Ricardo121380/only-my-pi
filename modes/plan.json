{
  "$schema": "../schemas/mode-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "runtime-ready",
  "id": "plan",
  "version": "1.0.0",
  "displayName": "Plan",
  "description": "Read-only planning mode that produces an executable plan before any mutation.",
  "category": "core",
  "executionState": "plan",
  "extends": [],
  "aliases": [],
  "requires": { "profileCapabilities": ["workspace-read", "planning"], "packages": ["plan-mode"], "enforcementSurfaces": ["toolCallPolicy", "fileToolPolicy"] },
  "prompt": { "file": "modes/prompts/plan.md" },
  "tools": { "allow": ["read", "grep", "find", "ls"], "deny": ["bash", "edit", "write", "web"], "required": ["read"] },
  "policy": { "workspace": "read-only", "egress": { "web": "deny", "mcp": "deny", "provider": "inherit", "extension": "deny" }, "approval": "deny" },
  "workflow": { "default": "plan-build-review", "fallback": "single-agent-safe" },
  "swarm": { "allowed": false, "defaultRecipe": null },
  "completion": { "gates": ["schema-check"], "requiresStructuredVerdict": true },
  "risk": "low"
}
