{
  "$schema": "../schemas/workflow-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "runtime-ready",
  "id": "research-report",
  "version": "1.0.0",
  "description": "Perform allow-listed, cookie-free research and verify its evidence receipt.",
  "entryConditions": ["profile-resolved", "mode-resolved", "session-idle"],
  "mutationScope": "none",
  "budget": { "maxSteps": 3, "maxParallel": 1, "timeoutSeconds": 4800, "retry": 0, "maxOutputBytes": 65536 },
  "fallback": { "when": ["missing-package", "missing-capability", "unavailable-runner"], "workflow": "single-agent-safe", "requiresApproval": false },
  "steps": [
    { "id": "research", "action": "agent", "agent": "researcher", "needs": [], "policyRef": "research", "approval": "user", "timeoutSeconds": 1800 },
    { "id": "source-check", "action": "gate", "gate": "diff-check", "needs": ["research"], "policyRef": "research", "approval": "none", "timeoutSeconds": 300 },
    { "id": "verify", "action": "gate", "gate": "schema-check", "needs": ["source-check"], "policyRef": "verify", "approval": "none", "timeoutSeconds": 300 }
  ],
  "terminal": { "step": "verify", "acceptedVerdicts": ["pass"], "rejectedVerdicts": ["fail", "blocked", "cancelled"], "requiresVerifierGate": true },
  "cancellation": { "stopAdmission": true, "waitForTerminalProof": true, "terminalVerdict": "cancelled" },
  "failure": { "onStepFailure": "fail", "onGateFailure": "fail" },
  "recovery": { "durableState": true, "verifySourceHash": true, "resumeFrom": "last-settled-step" }
}
