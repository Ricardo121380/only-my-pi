{
  "$schema": "../schemas/workflow-v1.schema.json",
  "formatVersion": 1,
  "contractStatus": "contract-only",
  "id": "single-agent-safe",
  "version": "1.0.0",
  "description": "Serial, read-only fallback executed by the parent-session Workflow Core when richer capabilities are unavailable.",
  "entryConditions": ["profile-resolved", "mode-resolved", "session-idle"],
  "mutationScope": "none",
  "budget": {
    "maxSteps": 2,
    "timeoutSeconds": 1200,
    "maxOutputBytes": 65536
  },
  "fallback": {
    "when": ["missing-package", "missing-capability", "unavailable-runner"],
    "workflow": null,
    "requiresApproval": false
  },
  "steps": [
    {
      "id": "inspect",
      "action": "agent",
      "agent": "scout",
      "needs": [],
      "policyRef": "inspect",
      "approval": "none"
    },
    {
      "id": "verify",
      "action": "gate",
      "gate": "test-contract",
      "needs": ["inspect"],
      "policyRef": "inspect",
      "approval": "none"
    }
  ],
  "terminal": {
    "step": "verify",
    "acceptedVerdicts": ["pass"],
    "rejectedVerdicts": ["fail", "blocked", "cancelled"],
    "requiresVerifierGate": true
  },
  "cancellation": {
    "stopAdmission": true,
    "waitForTerminalProof": true,
    "terminalVerdict": "cancelled"
  },
  "failure": {
    "onStepFailure": "fail",
    "onGateFailure": "fail"
  },
  "recovery": {
    "durableState": true,
    "verifySourceHash": true,
    "resumeFrom": "last-settled-step"
  }
}
