{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/stack-manifest-v1.schema.json",
  "title": "only-my-pi canonical stack manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "kind", "stackId", "sourceCommit", "onlyMyPi", "platform", "runtime", "externalPackages", "externalTreeDigest", "transitiveLedgerSha256", "generationTargetGraphDigest", "defaultPreset", "overlays", "capabilityCeiling", "policy", "removalPolicy"],
  "allOf": [
    {
      "if": { "properties": { "runtime": { "type": "object", "properties": { "pi": { "type": "object", "properties": { "version": { "const": "0.85.1" } } } } } } },
      "then": { "required": ["privateRuntimeDigest"], "properties": { "onlyMyPi": { "type": "object", "properties": { "version": { "const": "0.3.0-preview.1" } } }, "externalPackages": { "type": "array", "items": { "type": "object", "properties": { "binding": { "const": "stack" }, "owner": { "const": "only-my-pi" } } } }, "policy": { "type": "object", "properties": { "externalOwner": { "const": "only-my-pi" } } } } },
      "else": { "not": { "required": ["privateRuntimeDigest"] }, "properties": { "externalPackages": { "type": "array", "items": { "type": "object", "properties": { "binding": { "const": "external" }, "owner": { "const": "user" } } } }, "policy": { "type": "object", "properties": { "externalOwner": { "const": "user" } } } } }
    },
    {
      "if": { "properties": { "onlyMyPi": { "type": "object", "properties": { "version": { "const": "0.2.0-preview.1" } } } } },
      "then": {
        "properties": {
          "overlays": { "type": "object",
            "properties": {
              "enabled": { "const": ["web", "orchestration-readonly", "ui-terminal"] },
              "disabled": { "const": ["memory", "sync", "mcp", "experimental"] }
            }
          },
          "capabilityCeiling": { "type": "object",
            "properties": {
              "mode": { "const": "READ_ONLY" }, "maxDepth": { "const": 1 }, "writer": { "const": false }, "bash": { "const": false }, "mcp": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "onlyMyPi": { "type": "object", "properties": { "version": { "const": "0.3.0-preview.1" } } } } },
      "then": {
        "properties": {
          "overlays": { "type": "object",
            "properties": {
              "enabled": { "const": ["web", "orchestration-readonly", "ui-terminal", "writer"] },
              "disabled": { "const": ["memory", "sync", "mcp", "experimental"] }
            }
          },
          "capabilityCeiling": { "type": "object",
            "properties": {
              "mode": { "const": "GUARDED_PROJECT_CODING" }, "maxDepth": { "const": 1 }, "writer": { "const": true }, "bash": { "const": true }, "mcp": { "const": false }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "$schema": { "const": "../../schemas/stack-manifest-v1.schema.json" },
    "formatVersion": { "const": 1 },
    "kind": { "const": "only-my-pi-stack-manifest" },
    "stackId": { "$ref": "#/$defs/sha256" },
    "privateRuntimeDigest": { "$ref": "#/$defs/sha256" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "onlyMyPi": {
      "type": "object", "additionalProperties": false, "required": ["version", "artifactSha256"],
      "properties": { "version": { "enum": ["0.2.0-preview.1", "0.3.0-preview.1"] }, "artifactSha256": { "$ref": "#/$defs/sha256" } }
    },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["os", "arch", "minimumMacOS"],
      "properties": { "os": { "const": "darwin" }, "arch": { "const": "arm64" }, "minimumMacOS": { "const": "14.0" } }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["node", "pi"],
      "properties": {
        "node": {
          "type": "object", "additionalProperties": false, "required": ["version", "archiveName", "archiveSha256", "license", "treeDigest"],
          "properties": {
            "version": { "const": "24.19.0" },
            "archiveName": { "const": "node-v24.19.0-darwin-arm64.tar.gz" },
            "archiveSha256": { "const": "sha256:8294b7aa9b03997481c06babf1e8b270c859358f27da57a11509afe537ac381d" },
            "license": { "const": "MIT" },
            "treeDigest": { "$ref": "#/$defs/sha256" }
          }
        },
        "pi": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "integrity", "treeDigest", "entry"],
          "oneOf": [
            { "properties": { "version": { "const": "0.84.3" }, "integrity": { "const": "sha512-Yr2p9PubrbFZmYEPYI+C8KmZP9xlFuLDnAG64RtU0ZDgrdiXYWa+y7WGyJO5OlqPliOkVCMd9IzVszO3/t0D0w==" } } },
            { "properties": { "version": { "const": "0.85.1" }, "integrity": { "const": "sha512-FGRN+OHbWaefBPGaTggAdLjrIHW+s2PzLyglz/5dfLzb9of7uuXMXYC0fJIeZTw+shS32o2cuQ9jF7YSDuL/oQ==" } } }
          ],
          "properties": {
            "name": { "const": "@earendil-works/pi-coding-agent" },
            "version": { "enum": ["0.84.3", "0.85.1"] },
            "integrity": { "$ref": "#/$defs/sri" },
            "treeDigest": { "$ref": "#/$defs/sha256" },
            "entry": { "const": "dist/bundle/cli.js" }
          }
        }
      }
    },
    "externalPackages": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/externalPackage" } },
    "externalTreeDigest": { "$ref": "#/$defs/sha256" },
    "transitiveLedgerSha256": { "$ref": "#/$defs/sha256" },
    "generationTargetGraphDigest": { "$ref": "#/$defs/sha256" },
    "defaultPreset": { "const": "daily" },
    "overlays": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "disabled"],
      "properties": {
        "enabled": { "type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["web", "orchestration-readonly", "ui-terminal", "writer"] } },
        "disabled": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["memory", "sync", "mcp", "experimental"] } }
      }
    },
    "capabilityCeiling": {
      "type": "object", "additionalProperties": false, "required": ["mode", "maxDepth", "writer", "bash", "mcp"],
      "properties": {
        "mode": { "enum": ["READ_ONLY", "GUARDED_PROJECT_CODING"] }, "maxDepth": { "const": 1 }, "writer": { "type": "boolean" }, "bash": { "type": "boolean" }, "mcp": { "const": false }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["lifecycleScriptsDisabled", "networkDuringApply", "externalOwner", "webConfirmation", "browserCookies"],
      "properties": {
        "lifecycleScriptsDisabled": { "const": true }, "networkDuringApply": { "const": false }, "externalOwner": { "enum": ["user", "only-my-pi"] },
        "webConfirmation": { "const": "PER_RUN" }, "browserCookies": { "const": false }
      }
    },
    "removalPolicy": {
      "type": "object", "additionalProperties": false, "required": ["preservePreexisting", "removeOnlyVerifiedProvisioned", "preserveUserData"],
      "properties": {
        "preservePreexisting": { "const": true }, "removeOnlyVerifiedProvisioned": { "const": true }, "preserveUserData": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sri": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
    "externalPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "integrity", "license", "treeDigest", "binding", "owner", "lifecycleScripts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "integrity": { "$ref": "#/$defs/sri" },
        "license": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$" },
        "treeDigest": { "$ref": "#/$defs/sha256" },
        "binding": { "enum": ["external", "stack"] }, "owner": { "enum": ["user", "only-my-pi"] },
        "lifecycleScripts": {
          "type": "array", "maxItems": 9,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "commandSha256", "executed"],
            "properties": {
              "name": { "enum": ["preinstall", "install", "postinstall", "prepublish", "preprepare", "prepare", "postprepare", "prepack", "postpack"] },
              "commandSha256": { "$ref": "#/$defs/sha256" },
              "executed": { "const": false }
            }
          }
        }
      }
    }
  }
}
