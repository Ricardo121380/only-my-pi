{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/workflow-run-plan-v1.schema.json",
  "title": "only-my-pi durable WorkflowRunPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contractStatus", "createdAt", "digest", "executionEnvelope", "executionEnvelopeDigest", "formatVersion", "inputDigest", "inputPolicy", "plan", "planDigest", "runId", "sourceHash", "updatedAt"],
  "properties": {
    "$schema": { "const": "https://github.com/Ricardo121380/only-my-pi/schemas/workflow-run-plan-v1.schema.json" },
    "contractStatus": { "const": "contract-preview" },
    "createdAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "#/$defs/sha256" },
    "executionEnvelope": { "$ref": "#/$defs/executionEnvelope" },
    "executionEnvelopeDigest": { "$ref": "#/$defs/sha256" },
    "formatVersion": { "const": 1 },
    "inputDigest": { "$ref": "#/$defs/sha256" },
    "inputPolicy": { "const": "caller-must-reprovide" },
    "plan": { "$ref": "#/$defs/workflowPlan" },
    "planDigest": { "$ref": "#/$defs/sha256" },
    "runId": { "$ref": "#/$defs/id" },
    "sourceHash": { "$ref": "#/$defs/sha256" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "workflowPlan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["$schema", "formatVersion", "contractStatus", "id", "definitionVersion", "definitionDigest", "revision", "policy", "policyDigest", "budget", "nodes", "entryNodeIds", "terminalNodeId", "planDigest"],
      "properties": {
        "$schema": { "type": "string", "pattern": "workflow-plan-v1\\.schema\\.json$" },
        "formatVersion": { "const": 1 },
        "contractStatus": { "enum": ["contract-preview", "runtime-ready", "contract-only"] },
        "id": { "$ref": "#/$defs/planId" },
        "definitionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "definitionDigest": { "$ref": "#/$defs/sha256" },
        "revision": { "type": "object", "required": ["number", "parentPlanDigest", "reason", "activationPolicy"], "properties": { "number": { "type": "integer", "minimum": 0 }, "parentPlanDigest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }, "reason": { "type": "string" }, "activationPolicy": { "enum": ["drain", "stop"] } } },
        "policy": { "type": "object" },
        "policyDigest": { "$ref": "#/$defs/sha256" },
        "budget": { "type": "object" },
        "nodes": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "object" } },
        "entryNodeIds": { "type": "array", "items": { "$ref": "#/$defs/planId" } },
        "terminalNodeId": { "$ref": "#/$defs/planId" },
        "planDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "planId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "executionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "executionEnvelopeDigest", "formatVersion", "planDigest", "runId", "runInputDigest", "sourceHash", "target"],
      "properties": {
        "conditions": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$" } },
        "executionEnvelopeDigest": { "$ref": "#/$defs/sha256" },
        "formatVersion": { "const": 1 },
        "planDigest": { "$ref": "#/$defs/sha256" },
        "runId": { "$ref": "#/$defs/id" },
        "runInputDigest": { "$ref": "#/$defs/sha256" },
        "sourceHash": { "$ref": "#/$defs/sha256" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind"],
          "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["workflow", "swarm"] } }
        }
      }
    }
  }
}
