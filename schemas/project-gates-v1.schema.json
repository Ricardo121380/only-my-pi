{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/project-gates-v1.schema.json",
  "title": "only-my-pi Project Gate Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "id", "gates"],
  "properties": {
    "$schema": { "type": "string", "pattern": "project-gates-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "gates": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/gate" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "command", "args", "cwd", "timeoutSeconds", "env"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "command": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
        "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000\\r\\n]*$" } },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._@+ -]+(?:/[A-Za-z0-9._@+ -]+)*)$" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "env": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "pattern": "^(?!.*(?:KEY|TOKEN|SECRET|PASSWORD|COOKIE|AUTH))[A-Z][A-Z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string", "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]*$" }
        }
      }
    }
  }
}
