{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/artifact-ref-v1.schema.json",
  "title": "only-my-pi ArtifactRef v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "contractStatus", "kind", "id", "mediaType", "byteLength", "digest", "producer", "storage", "provenance"],
  "properties": {
    "$schema": { "type": "string", "pattern": "artifact-ref-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "contractStatus": { "enum": ["contract-preview", "runtime-ready"] },
    "kind": { "const": "artifact-ref" },
    "id": { "$ref": "#/$defs/id" },
    "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$", "maxLength": 128 },
    "byteLength": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
    "digest": { "$ref": "#/$defs/sha256" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "revision", "nodeId", "attemptId"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 0 },
        "nodeId": { "$ref": "#/$defs/id" },
        "attemptId": { "$ref": "#/$defs/id" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "relativePath"],
      "properties": {
        "scheme": { "const": "artifact" },
        "relativePath": { "$ref": "#/$defs/path" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDigest", "policyDigest", "redaction"],
      "properties": {
        "sourceDigest": { "$ref": "#/$defs/sha256" },
        "policyDigest": { "$ref": "#/$defs/sha256" },
        "redaction": { "enum": ["none", "bounded", "digest-only"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\u0000]+$" }
  }
}
