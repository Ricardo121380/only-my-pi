{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/subagents-live-provider-v1.schema.json",
  "title": "only-my-pi protected live Provider descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "provider", "descriptorDigest"],
  "properties": {
    "$schema": { "type": "string", "pattern": "subagents-live-provider-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "baseUrl", "api", "credentialEnvironment", "model"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000\\r\\n]+$" },
        "baseUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
        "api": { "enum": ["anthropic-messages", "google-generative-ai", "openai-completions", "openai-responses"] },
        "credentialEnvironment": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "descriptorDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "nonNegativeRate": { "type": "number", "minimum": 0, "maximum": 1000 },
    "compatValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000\\r\\n]+$" },
        { "type": "null" }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "reasoning", "input", "contextWindow", "maxTokens", "cost"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$" },
        "reasoning": { "type": "boolean" },
        "input": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["text", "image"] },
          "contains": { "const": "text" }
        },
        "contextWindow": { "type": "integer", "minimum": 1024, "maximum": 2000000 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "cacheRead", "cacheWrite"],
          "properties": {
            "input": { "$ref": "#/$defs/nonNegativeRate" },
            "output": { "$ref": "#/$defs/nonNegativeRate" },
            "cacheRead": { "$ref": "#/$defs/nonNegativeRate" },
            "cacheWrite": { "$ref": "#/$defs/nonNegativeRate" }
          }
        },
        "compat": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/compatValue" }
        },
        "thinkingLevelMap": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "minimal": { "type": ["string", "null"], "maxLength": 64 },
            "low": { "type": ["string", "null"], "maxLength": 64 },
            "medium": { "type": ["string", "null"], "maxLength": 64 },
            "high": { "type": ["string", "null"], "maxLength": 64 },
            "xhigh": { "type": ["string", "null"], "maxLength": 64 },
            "max": { "type": ["string", "null"], "maxLength": 64 }
          }
        }
      }
    }
  }
}
