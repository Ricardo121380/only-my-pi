{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/contract-catalog-v1.schema.json",
  "title": "only-my-pi schema contract catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "schemas"],
  "properties": {
    "$schema": { "type": "string", "pattern": "contract-catalog-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "schemas": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._*/-]+$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schemaPath", "productionGlobs", "fixtureDir"],
      "properties": {
        "kind": { "enum": ["inventory", "resourceInventory", "profile", "capability", "owner", "commandOwner", "enforcementSurface", "mode", "agent", "workflow", "swarmRecipe", "bootstrapTransaction", "bootstrapState", "bootstrapGeneration", "bootstrapSnapshot"] },
        "schemaPath": { "$ref": "#/$defs/path" },
        "productionGlobs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "fixtureDir": { "$ref": "#/$defs/path" }
      }
    }
  }
}
