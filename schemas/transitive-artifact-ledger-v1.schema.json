{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/transitive-artifact-ledger-v1.schema.json",
  "title": "only-my-pi transitive artifact ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "kind", "sourceCommit", "artifacts", "ledgerDigest"],
  "properties": {
    "$schema": { "const": "../../schemas/transitive-artifact-ledger-v1.schema.json" },
    "formatVersion": { "const": 1 },
    "kind": { "const": "only-my-pi-transitive-artifact-ledger" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "artifacts": { "type": "array", "minItems": 1, "maxItems": 4096, "items": { "$ref": "#/$defs/artifact" } },
    "ledgerDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sri": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
    "identity": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "tarballUrl", "integrity", "sha256", "license", "packageManifestDigest", "lifecycleScripts", "dependencies", "treeDigest", "topLevel"],
      "properties": {
        "name": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
        "tarballUrl": { "type": "string", "pattern": "^https://registry\\.npmjs\\.org/[^?#]+\\.tgz$", "maxLength": 512 },
        "integrity": { "$ref": "#/$defs/sri" }, "sha256": { "$ref": "#/$defs/sha256" },
        "license": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.()+ -]{0,127}$" },
        "packageManifestDigest": { "$ref": "#/$defs/sha256" },
        "lifecycleScripts": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "commandSha256", "executed"],
            "properties": {
              "name": { "enum": ["preinstall", "install", "postinstall", "prepare", "prepack", "postpack"] },
              "commandSha256": { "$ref": "#/$defs/sha256" }, "executed": { "const": false }
            }
          }
        },
        "dependencies": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
        "treeDigest": { "$ref": "#/$defs/sha256" }, "topLevel": { "type": "boolean" }
      }
    }
  }
}
