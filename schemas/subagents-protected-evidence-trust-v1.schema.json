{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/subagents-protected-evidence-trust-v1.schema.json",
  "title": "only-my-pi Subagents protected evidence trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "contractStatus", "id", "algorithm", "signers", "policyDigest"],
  "properties": {
    "$schema": { "type": "string", "pattern": "subagents-protected-evidence-trust-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "contractStatus": { "enum": ["configured-unavailable", "runtime-ready"] },
    "id": { "const": "only-my-pi-subagents-protected-evidence-trust" },
    "algorithm": { "const": "ed25519" },
    "signers": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/signer" }
    },
    "policyDigest": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "contractStatus": { "const": "configured-unavailable" } }, "required": ["contractStatus"] },
      "then": { "properties": { "signers": { "type": "array", "maxItems": 0 } } },
      "else": { "properties": { "signers": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "authorizationClass", "publicKeySpki", "publicKeyFingerprint", "evidenceIds", "notBefore", "notAfter"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["active", "revoked"] },
        "authorizationClass": { "const": "local-operator-protected-live" },
        "publicKeySpki": { "type": "string", "minLength": 56, "maxLength": 128, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
        "publicKeyFingerprint": { "$ref": "#/$defs/sha256" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "live-agent-terminal",
              "live-agent-cancel",
              "live-batch-terminal",
              "background-resume",
              "guarded-writer-integration"
            ]
          }
        },
        "notBefore": { "type": "string", "format": "date-time" },
        "notAfter": { "type": "string", "format": "date-time" }
      }
    }
  }
}
