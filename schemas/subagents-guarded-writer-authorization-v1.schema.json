{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/subagents-guarded-writer-authorization-v1.schema.json",
  "title": "only-my-pi Subagents guarded writer authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "formatVersion", "contractStatus", "authorizationId",
    "sourceCommit", "matrixDigest", "policyDigest", "trustPolicyDigest",
    "compatibilityRowId", "evidenceIds", "provider", "limits", "workspace",
    "writer", "signer", "approvedAt", "expiresAt", "authorizationDigest"
  ],
  "properties": {
    "$schema": { "type": "string", "pattern": "subagents-guarded-writer-authorization-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "contractStatus": { "enum": ["operator-template", "operator-authorized-live"] },
    "authorizationId": { "$ref": "#/$defs/id" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "matrixDigest": { "$ref": "#/$defs/sha256" },
    "policyDigest": { "$ref": "#/$defs/sha256" },
    "trustPolicyDigest": { "$ref": "#/$defs/sha256" },
    "compatibilityRowId": { "$ref": "#/$defs/id" },
    "evidenceIds": {
      "type": "array",
      "prefixItems": [{ "const": "guarded-writer-integration" }],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "configurationDigest", "credentialEnvironment", "declaredEndpointHosts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "model": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$" },
        "configurationDigest": { "$ref": "#/$defs/sha256" },
        "credentialEnvironment": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
        },
        "declaredEndpointHosts": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$", "maxLength": 253 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChildren", "maxConcurrency", "maxWallTimeMs", "maxOutputBytes", "maxTokens", "maxCostUsd"],
      "properties": {
        "maxChildren": { "const": 1 },
        "maxConcurrency": { "const": 1 },
        "maxWallTimeMs": { "type": "integer", "minimum": 2000, "maximum": 3600000 },
        "maxOutputBytes": { "type": "integer", "minimum": 2048, "maximum": 1048576 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxCostUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "realPiHome", "mutation", "web", "mcp", "projectTrust", "automaticIntegration", "parentDiffVerification"],
      "properties": {
        "mode": { "const": "disposable-managed-worktree" },
        "realPiHome": { "const": "deny" },
        "mutation": { "const": "guarded-exact-claims" },
        "web": { "const": "deny" },
        "mcp": { "const": "deny" },
        "projectTrust": { "const": "deny" },
        "automaticIntegration": { "const": false },
        "parentDiffVerification": { "const": "required" }
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "upstreamAgentId", "allowedPaths", "fileClaims", "baseCommitPolicy", "requiredGateIds", "expectedMarker"],
      "properties": {
        "agentId": { "const": "implementer" },
        "upstreamAgentId": { "const": "omp-implementer" },
        "allowedPaths": {
          "type": "array", "prefixItems": [{ "const": "fixture/allowed.txt" }], "items": false, "minItems": 1, "maxItems": 1
        },
        "fileClaims": {
          "type": "array", "prefixItems": [{ "const": "fixture/allowed.txt" }], "items": false, "minItems": 1, "maxItems": 1
        },
        "baseCommitPolicy": { "const": "fixture-head" },
        "requiredGateIds": {
          "type": "array",
          "prefixItems": [{ "const": "diff-check" }, { "const": "fixture-content" }],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "expectedMarker": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "publicKeyFingerprint", "protocol"],
      "properties": {
        "signerId": { "$ref": "#/$defs/id" },
        "publicKeyFingerprint": { "$ref": "#/$defs/sha256" },
        "protocol": { "const": "digest-stdin-signature-stdout-v1" }
      }
    },
    "approvedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "authorizationDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
