{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/capability-v1.schema.json",
  "title": "only-my-pi capability catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "capabilities"],
  "properties": {
    "$schema": { "type": "string", "pattern": "capability-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "idSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "surfaceId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]{0,63}$" },
    "surfaceSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/surfaceId" } },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "surfaces", "risk", "providedBy", "runtimeEvidenceRequired"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/surfaceId" } },
        "risk": { "enum": ["none", "low", "medium", "high", "critical"] },
        "providedBy": { "$ref": "#/$defs/idSet" },
        "requires": { "$ref": "#/$defs/idSet" },
        "conflictsWith": { "$ref": "#/$defs/idSet" },
        "runtimeEvidenceRequired": { "type": "boolean" }
      }
    }
  }
}
