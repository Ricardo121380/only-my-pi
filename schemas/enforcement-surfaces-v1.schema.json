{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/enforcement-surfaces-v1.schema.json",
  "title": "only-my-pi enforcement surface matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "surfaces"],
  "properties": {
    "$schema": { "type": "string", "pattern": "enforcement-surfaces-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]{0,63}$" },
    "state": { "enum": ["active", "degraded", "unavailable", "unknown", "restart-required", "unsupported"] },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "enforcementPoint", "mechanism", "observableStates", "stateSource", "degradedBehavior", "failureBehavior", "failClosed", "contractTests"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "owner": { "anyOf": [{ "$ref": "#/$defs/id" }, { "enum": ["none", "unknown"] }] },
        "enforcementPoint": { "type": "string", "minLength": 1, "maxLength": 300 },
        "mechanism": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observableStates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/state" } },
        "stateSource": { "type": "string", "minLength": 1, "maxLength": 300 },
        "degradedBehavior": { "type": "string", "minLength": 1, "maxLength": 500 },
        "failureBehavior": { "type": "string", "minLength": 1, "maxLength": 500 },
        "failClosed": { "type": "boolean" },
        "contractTests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" } }
      }
    }
  }
}
