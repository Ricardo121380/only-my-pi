{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/command-owner-v1.schema.json",
  "title": "only-my-pi command owner catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "commands"],
  "properties": {
    "$schema": { "type": "string", "pattern": "command-owner-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "commands": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/command" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "commandName": { "type": "string", "pattern": "^/?[a-z][a-z0-9:-]{0,63}$" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "owner", "aliases", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/commandName" },
        "surface": { "enum": ["cli", "pi-command", "pi-tool"] },
        "owner": { "$ref": "#/$defs/id" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/commandName" } },
        "status": { "enum": ["implemented", "reserved", "upstream", "compatibility-alias"] },
        "implementedBy": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._@/-]+$" }
      }
    }
  }
}
