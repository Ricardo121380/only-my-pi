{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/resources-lock-v1.schema.json",
  "title": "only-my-pi first-party resource inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "generatedAt", "resources"],
  "properties": {
    "$schema": { "type": "string", "pattern": "resources-lock-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "resources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resource" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "idSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "commandId": { "type": "string", "pattern": "^/?[a-z][a-z0-9:-]{0,63}$" },
    "commandSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/commandId" } },
    "surfaceId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]{0,63}$" },
    "surfaceSet": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/surfaceId" } },
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000)[A-Za-z0-9._@/-]+$" },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "version", "provides", "requires", "owners", "commands", "egressSurfaces", "defaultLoaded", "profileEligibility", "lifecycle", "packaged"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["extension", "library", "skill", "prompt", "theme", "mode", "agent", "workflow", "swarm-recipe", "lab"] },
        "path": { "$ref": "#/$defs/path" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provides": { "$ref": "#/$defs/idSet" },
        "requires": { "$ref": "#/$defs/idSet" },
        "owners": { "$ref": "#/$defs/idSet" },
        "commands": { "$ref": "#/$defs/commandSet" },
        "egressSurfaces": { "$ref": "#/$defs/surfaceSet" },
        "defaultLoaded": { "type": "boolean" },
        "profileEligibility": { "$ref": "#/$defs/idSet" },
        "lifecycle": { "enum": ["stable", "experimental", "labs", "planned"] },
        "packaged": { "type": "boolean" }
      }
    }
  }
}
