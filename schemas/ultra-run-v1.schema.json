{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/ultra-run-v1.schema.json",
  "title": "only-my-pi UltraRun strategy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "contractStatus", "kind", "id", "version", "effort", "routePolicy", "workflowLibrary", "quality", "budgetRef", "approvalPolicy"],
  "properties": {
    "$schema": { "type": "string", "pattern": "ultra-run-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "contractStatus": { "const": "contract-preview" },
    "kind": { "const": "ultra-run" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "effort": { "enum": ["quick", "standard", "deep", "critical"] },
    "routePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singleAgentMaxComplexity", "batchMinItems", "dynamicGoalRequiresExplicitApproval"],
      "properties": {
        "singleAgentMaxComplexity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "batchMinItems": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "dynamicGoalRequiresExplicitApproval": { "const": true }
      }
    },
    "workflowLibrary": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshVerifier", "testGate", "integrationGate"],
      "properties": {
        "freshVerifier": { "const": true },
        "testGate": { "$ref": "#/$defs/id" },
        "integrationGate": { "$ref": "#/$defs/id" }
      }
    },
    "budgetRef": { "$ref": "#/$defs/id" },
    "approvalPolicy": { "enum": ["exact-mutating-revision", "always-explicit"] }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
  }
}
