{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/workflow-cancel-request-v1.schema.json",
  "title": "only-my-pi durable Workflow cancel request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "createdAt", "digest", "formatVersion", "reason", "requestId", "runId", "status", "updatedAt"],
  "properties": {
    "$schema": { "const": "https://github.com/Ricardo121380/only-my-pi/schemas/workflow-cancel-request-v1.schema.json" },
    "createdAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "#/$defs/sha256" },
    "formatVersion": { "const": 1 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000\\r\\n]+$" },
    "requestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,191}$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "status": { "const": "PENDING" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
