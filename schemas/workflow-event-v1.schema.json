{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/workflow-event-v1.schema.json",
  "title": "only-my-pi append-only WorkflowEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "runId", "seq", "eventId", "type", "timestamp", "revision", "nodeId", "attemptId", "swarmRunId", "childId", "writerId", "fencingToken", "inputDigest", "prevEventDigest", "payload", "eventDigest"],
  "properties": {
    "formatVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/id" },
    "seq": { "type": "integer", "minimum": 1 },
    "eventId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,191}$" },
    "type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,63}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 0 },
    "nodeId": { "$ref": "#/$defs/nullableId" },
    "attemptId": { "$ref": "#/$defs/nullableId" },
    "swarmRunId": { "$ref": "#/$defs/nullableId" },
    "childId": { "$ref": "#/$defs/nullableId" },
    "writerId": { "$ref": "#/$defs/id" },
    "fencingToken": { "type": "integer", "minimum": 1 },
    "inputDigest": { "$ref": "#/$defs/sha256" },
    "prevEventDigest": { "$ref": "#/$defs/sha256" },
    "payload": {},
    "eventDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "nullableId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
