{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/upstream-migration-v1.schema.json",
  "title": "only-my-pi upstream migration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "id", "sourceCommit", "candidateGraphDigest", "onlyMyPiArtifact", "piArtifact", "from", "to", "externalPackages", "artifacts", "policy", "manifestDigest"],
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "only-my-pi-upstream-migration" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidateGraphDigest": { "$ref": "#/$defs/sha256" },
    "onlyMyPiArtifact": {
      "type": "object", "additionalProperties": false, "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "piArtifact": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "integrity", "sha256", "treeDigest"],
      "properties": {
        "name": { "const": "@earendil-works/pi-coding-agent" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "integrity": { "$ref": "#/$defs/sri" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "treeDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "from": { "$ref": "#/$defs/runtime" },
    "to": { "$ref": "#/$defs/runtime" },
    "externalPackages": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": { "$ref": "#/$defs/externalPackage" }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle-receipt.json", "external-npm-tree.tgz", "external-package-lock.json", "only-my-pi.tgz", "pi-candidate.tgz"],
      "properties": {
        "bundle-receipt.json": { "$ref": "#/$defs/sha256" },
        "external-npm-tree.tgz": { "$ref": "#/$defs/sha256" },
        "external-package-lock.json": { "$ref": "#/$defs/sha256" },
        "only-my-pi.tgz": { "$ref": "#/$defs/sha256" },
        "pi-candidate.tgz": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["ignoreScripts", "allowLifecycleScripts", "requirePiStopped", "preserveExternalOwnership", "networkDuringApply"],
      "properties": {
        "ignoreScripts": { "const": true },
        "allowLifecycleScripts": { "const": false },
        "requirePiStopped": { "const": true },
        "preserveExternalOwnership": { "const": true },
        "networkDuringApply": { "const": false }
      }
    },
    "manifestDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sri": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["piVersion", "subagentsVersion"],
      "properties": {
        "piVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "subagentsVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "externalPackage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "fromVersion", "toVersion", "sourceSpec", "fromIntegrity", "toIntegrity", "fromResolvedUrlDigest", "toResolvedUrlDigest", "fromTreeDigest", "toTreeDigest", "binding", "owner", "action", "fromLifecycleScripts", "toLifecycleScripts"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "pattern": "^(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)$" },
        "fromVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "toVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sourceSpec": { "type": "string", "pattern": "^npm:(?:@[a-z0-9._-]+/[a-z0-9._-]+|[a-z0-9._-]+)@[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "fromIntegrity": { "$ref": "#/$defs/sri" },
        "toIntegrity": { "$ref": "#/$defs/sri" },
        "fromResolvedUrlDigest": { "$ref": "#/$defs/sha256" },
        "toResolvedUrlDigest": { "$ref": "#/$defs/sha256" },
        "fromTreeDigest": { "$ref": "#/$defs/sha256" },
        "toTreeDigest": { "$ref": "#/$defs/sha256" },
        "binding": { "const": "external" },
        "owner": { "const": "user" },
        "action": { "enum": ["upgrade", "retain"] },
        "fromLifecycleScripts": { "$ref": "#/$defs/lifecycleScripts" },
        "toLifecycleScripts": { "$ref": "#/$defs/lifecycleScripts" }
      }
    },
    "lifecycleScripts": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "commandSha256", "necessity"],
        "properties": {
          "name": { "enum": ["preinstall", "install", "postinstall", "prepare", "prepack", "postpack"] },
          "commandSha256": { "$ref": "#/$defs/sha256" },
          "necessity": { "const": "not-required" }
        }
      }
    }
  }
}
