{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/legacy-authority-v1.schema.json",
  "title": "only-my-pi legacy authority registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "kind", "authorityClass", "currentReleaseAuthority", "retirementReason", "replacementAuthority", "legacySnapshotCommit", "legacySnapshotTree", "entries", "registryDigest"],
  "properties": {
    "$schema": { "const": "../schemas/legacy-authority-v1.schema.json" },
    "formatVersion": { "const": 1 },
    "kind": { "const": "only-my-pi-legacy-authority" },
    "authorityClass": { "const": "LEGACY_PRIVATE_HISTORY" },
    "currentReleaseAuthority": { "const": false },
    "retirementReason": { "const": "SOURCE_COMMIT_REWRITTEN_FOR_EMAIL_PRIVACY" },
    "replacementAuthority": { "const": "public-baseline-v1" },
    "legacySnapshotCommit": { "$ref": "#/$defs/commit" },
    "legacySnapshotTree": { "$ref": "#/$defs/commit" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/entry" }
    },
    "registryDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "nullableCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^verification/(?:evidence|protected|receipts)/[A-Za-z0-9._-]+\\.json$", "maxLength": 240 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileSha256", "originalClaimType", "originalSourceCommit", "originalEvidenceCommit", "originalStatus", "internalDigest", "gitAuthority", "currentReleaseAuthority"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "originalClaimType": { "enum": ["DETERMINISTIC_EVIDENCE", "PROTECTED_EVIDENCE", "COMPLETION_RECEIPT"] },
        "originalSourceCommit": { "$ref": "#/$defs/nullableCommit" },
        "originalEvidenceCommit": { "$ref": "#/$defs/nullableCommit" },
        "originalStatus": { "type": "string", "minLength": 2, "maxLength": 96, "pattern": "^[A-Z][A-Z0-9_-]+$" },
        "internalDigest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "field", "declared"],
          "properties": {
            "status": { "enum": ["PASS", "NOT_APPLICABLE"] },
            "field": { "type": ["string", "null"], "enum": ["evidenceDigest", null] },
            "declared": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
          }
        },
        "gitAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["directChildStatus", "reason"],
          "properties": {
            "directChildStatus": { "const": "UNAVAILABLE_AFTER_REWRITE" },
            "reason": { "const": "SOURCE_COMMIT_REWRITTEN_FOR_EMAIL_PRIVACY" }
          }
        },
        "currentReleaseAuthority": { "const": false }
      }
    }
  }
}
