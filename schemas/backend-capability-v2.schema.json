{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/backend-capability-v2.schema.json",
  "title": "only-my-pi BackendCapabilityV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "contractStatus", "kind", "backendId", "backendVersion", "protocol", "observedAt", "capabilities", "capabilityHash"],
  "properties": {
    "$schema": { "type": "string", "pattern": "backend-capability-v2\\.schema\\.json$" },
    "formatVersion": { "const": 2 },
    "contractStatus": { "const": "contract-preview" },
    "kind": { "const": "backend-capability-matrix" },
    "backendId": { "$ref": "#/$defs/id" },
    "backendVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "observedAt": { "type": "integer", "minimum": 0 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "background", "continuableResume", "status", "steer", "interrupt", "stop", "resume", "dispose", "terminalEvents", "processTerminalProof", "worktree", "perItemResult", "usageMeter", "rateLimitSignal", "dynamicConcurrency", "modelOverlay", "toolOverlay", "structuredOutput"],
      "properties": {
        "foreground": { "$ref": "#/$defs/capability" },
        "background": { "$ref": "#/$defs/capability" },
        "continuableResume": { "$ref": "#/$defs/capability" },
        "status": { "$ref": "#/$defs/capability" },
        "steer": { "$ref": "#/$defs/capability" },
        "interrupt": { "$ref": "#/$defs/capability" },
        "stop": { "$ref": "#/$defs/capability" },
        "resume": { "$ref": "#/$defs/capability" },
        "dispose": { "$ref": "#/$defs/capability" },
        "terminalEvents": { "$ref": "#/$defs/capability" },
        "processTerminalProof": { "$ref": "#/$defs/capability" },
        "worktree": { "$ref": "#/$defs/capability" },
        "perItemResult": { "$ref": "#/$defs/capability" },
        "usageMeter": { "$ref": "#/$defs/capability" },
        "rateLimitSignal": { "$ref": "#/$defs/capability" },
        "dynamicConcurrency": { "$ref": "#/$defs/capability" },
        "modelOverlay": { "$ref": "#/$defs/capability" },
        "toolOverlay": { "$ref": "#/$defs/capability" },
        "structuredOutput": { "$ref": "#/$defs/capability" }
      }
    },
    "capabilityHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCode", "evidence", "constraints"],
      "properties": {
        "state": { "enum": ["SUPPORTED", "DEGRADED", "UNAVAILABLE"] },
        "reasonCode": { "$ref": "#/$defs/id" },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "constraints": { "type": "object" }
      }
    }
  }
}
