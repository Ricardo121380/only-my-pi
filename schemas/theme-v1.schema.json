{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ricardo121380/only-my-pi/schemas/theme-v1.schema.json",
  "title": "only-my-pi semantic theme contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "contractStatus", "id", "displayName", "themePath", "piThemeName", "mode", "tokens", "contrast", "safeDisable"],
  "properties": {
    "$schema": { "type": "string", "pattern": "theme-v1\\.schema\\.json$" },
    "formatVersion": { "const": 1 },
    "contractStatus": { "enum": ["contract-only", "runtime-ready"] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "themePath": { "type": "string", "pattern": "^themes/[A-Za-z0-9._-]+\\.json$" },
    "piThemeName": { "type": "string", "pattern": "^[^/\\u0000\\r\\n]{1,128}$" },
    "mode": { "enum": ["dark", "light"] },
    "tokens": { "$ref": "#/$defs/tokens" },
    "contrast": { "$ref": "#/$defs/contrast" },
    "safeDisable": { "enum": ["restore-default", "headless-noop"] },
    "description": { "type": "string", "maxLength": 512 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accent", "text", "background", "surface", "border", "success", "warning", "error", "diffAdded", "diffRemoved", "roleUser", "shellMode"],
      "properties": {
        "primary": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "success": { "$ref": "#/$defs/color" },
        "warning": { "$ref": "#/$defs/color" },
        "error": { "$ref": "#/$defs/color" },
        "diffAdded": { "$ref": "#/$defs/color" },
        "diffRemoved": { "$ref": "#/$defs/color" },
        "roleUser": { "$ref": "#/$defs/color" },
        "shellMode": { "$ref": "#/$defs/color" }
      }
    },
    "contrastCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "foreground", "background", "ratio", "pass"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "foreground": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "ratio": { "type": "number", "minimum": 1, "maximum": 21 },
        "pass": { "type": "boolean" }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minTextRatio", "minUiRatio", "checks"],
      "properties": {
        "minTextRatio": { "type": "number", "minimum": 4.5, "maximum": 21 },
        "minUiRatio": { "type": "number", "minimum": 3, "maximum": 21 },
        "checks": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/contrastCheck" } }
      }
    }
  }
}
