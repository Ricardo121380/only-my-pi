{
  "$schema": "../schemas/overlay-v1.schema.json",
  "formatVersion": 1,
  "id": "core",
  "kind": "base",
  "description": "First-party control, planning, permissions, LSP, usage and filtered session/context/review/notify resources.",
  "packageIds": ["plan-mode", "agent-extensions", "permission-modes", "lsp", "usage"],
  "capabilityIds": ["workspace-read", "planning", "permission-policy", "lsp", "usage-observability"],
  "authority": { "network": "deny", "persistence": "session", "tools": ["read", "grep", "find", "ls"], "webConfirmation": false, "browserCookies": false },
  "defaultEnabled": true,
  "available": true
}
