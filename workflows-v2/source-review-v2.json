{
  "$schema": "../schemas/workflow-definition-v2.schema.json",
  "formatVersion": 2,
  "contractStatus": "runtime-ready",
  "id": "source-review-v2",
  "version": "2.1.0",
  "description": "Read-only source exploration and review, followed by synthesis and a fresh Agent verifier.",
  "policy": {
    "workspace": "shared-read-only",
    "mutation": "none",
    "egress": { "web": "deny", "mcp": "deny", "provider": "allow" },
    "tools": { "allow": ["read"], "deny": ["bash", "edit", "write", "web"] }
  },
  "budget": {
    "maxNodes": 4,
    "maxParallel": 2,
    "maxDepth": 3,
    "maxAttemptsPerNode": 1,
    "maxWallTimeMs": 1200000,
    "maxOutputBytes": 262144,
    "maxAssignments": 4,
    "maxTokens": 25000,
    "maxCostUsd": 0.125
  },
  "flow": {
    "kind": "sequence",
    "steps": [
      {
        "kind": "parallel",
        "branches": [
          {
            "kind": "agent",
            "id": "explore",
            "agentTemplateRef": "explorer",
            "assignment": { "taskTemplateRef": "ultra-explore" },
            "outputSchemaRef": null,
            "policy": { "workspace": "shared-read-only", "mutation": "none", "tools": { "allow": ["read"], "deny": ["bash", "edit", "write", "web"] } },
            "budget": { "maxAttempts": 1, "timeoutMs": 300000, "maxOutputBytes": 65536, "maxTokens": 5000, "maxCostUsd": 0.025 },
            "cache": { "mode": "content-addressed", "keyInputs": ["assignment", "dependencies"] },
            "idempotency": "content-addressed"
          },
          {
            "kind": "agent",
            "id": "review",
            "agentTemplateRef": "reviewer",
            "assignment": { "taskTemplateRef": "ultra-review" },
            "outputSchemaRef": null,
            "policy": { "workspace": "shared-read-only", "mutation": "none", "tools": { "allow": ["read"], "deny": ["bash", "edit", "write", "web"] } },
            "budget": { "maxAttempts": 1, "timeoutMs": 300000, "maxOutputBytes": 65536, "maxTokens": 5000, "maxCostUsd": 0.025 },
            "cache": { "mode": "content-addressed", "keyInputs": ["assignment", "dependencies"] },
            "idempotency": "content-addressed"
          }
        ]
      },
      {
        "kind": "agent",
        "id": "synthesize",
        "agentTemplateRef": "synthesizer",
        "assignment": { "taskTemplateRef": "ultra-synthesize" },
        "outputSchemaRef": null,
        "policy": { "workspace": "shared-read-only", "mutation": "none", "tools": { "allow": ["read"], "deny": ["bash", "edit", "write", "web"] } },
        "budget": { "maxAttempts": 1, "timeoutMs": 300000, "maxOutputBytes": 65536, "maxTokens": 5000, "maxCostUsd": 0.025 },
        "cache": { "mode": "content-addressed", "keyInputs": ["assignment", "dependencies"] },
        "idempotency": "content-addressed"
      },
      {
        "kind": "agent",
        "id": "verify",
        "agentTemplateRef": "verifier",
        "assignment": { "taskTemplateRef": "ultra-verify" },
        "outputSchemaRef": null,
        "policy": { "workspace": "shared-read-only", "mutation": "none", "tools": { "allow": ["read"], "deny": ["bash", "edit", "write", "web"] } },
        "budget": { "maxAttempts": 1, "timeoutMs": 300000, "maxOutputBytes": 65536, "maxTokens": 10000, "maxCostUsd": 0.05 },
        "cache": { "mode": "content-addressed", "keyInputs": ["assignment", "dependencies"] },
        "idempotency": "content-addressed"
      }
    ]
  },
  "terminalNodeId": "verify"
}
